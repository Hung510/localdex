<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Lets LocalDex switch Wireless debugging back on by itself. Not grantable at
        install time; the app grants it to itself over ADB once paired (see
        WirelessDebugging). Harmless when never granted.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Quyền hiển thị trên ứng dụng khác (để app tự bật lên mượt mà) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalDex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            configChanges keeps the activity alive across rotation/fold changes so the
            decoder surface isn't torn down mid-stream. launchMode singleTask so the
            notification tap returns to the existing viewer.
        -->
        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.LocalDex.Viewer" />

        <!-- Owns the Dex session; its notification is the guaranteed stop switch. -->
        <service
            android:name=".DexService"
            android:exported="false" />

        <!--
            Pairing input service with RemoteInput. No foregroundServiceType: at
            targetSdk 30 the platform does not require one (see anyapk's notes).
        -->
        <service
            android:name=".PairingInputService"
            android:exported="false" />

        <receiver
            android:name=".PairingInputReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.localdex.PAIRING_INPUT" />
                <action android:name="com.localdex.PAIRING_CANCEL" />
            </intent-filter>
        </receiver>

        <!-- Phím tắt giúp Samsung Routines hiển thị tùy chọn riêng thay vì chỉ mở app trơ trơ -->
        <activity-alias
            android:name=".StartDexShortcut"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Bật LocalDeX ngay"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Lắng nghe sự kiện cắm cáp/thiết bị ngoài để tự động bật DeX -->
        <receiver
            android:name=".DisplayConnectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.intent.action.HDMI_PLUGGED" />
            </intent-filter>
        </receiver>
        <!-- ========================================== -->
        <!-- BỔ SUNG: Khai báo LocalDeX Widget Provider -->
        <!-- ========================================== -->
        <receiver
            android:name=".LocalDexWidgetProvider"
            android:exported="true"
            android:label="LocalDeX Quick Launch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/localdex_widget_info" />
        </receiver>

    </application>

</manifest>
